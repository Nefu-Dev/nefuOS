static void mp_obj_float_divmod(mp_float_t *x, mp_float_t *y) {




    mp_float_t mod = fmod(*x, *y);
    mp_float_t div = (*x - mod) / *y;


    if (mod == 0.0) {
        mod = copysign(0.0, *y);
    } else {
        if ((mod < 0.0) != (*y < 0.0)) {
            mod += *y;
            div -= 1.0;
        }
    }

    mp_float_t floordiv;
    if (div == 0.0) {

        floordiv = copysign(0.0, *x / *y);
    } else {

        floordiv = floor(div);
        if (div - floordiv > 0.5) {
            floordiv += 1.0;
        }
    }


    *x = floordiv;
    *y = mod;
}

